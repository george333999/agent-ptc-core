{
  "name": "local-first-agent-workbench-core",
  "version": "0.3.1",
  "description": "Local-first coding agent core: cache-stable long conversations, context prefetch, tool-result distillation, sandboxed programmatic tool calls, and write-lock verification scheduling.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/george333999/local-first-agent-workbench.git"
  },
  "homepage": "https://gitee.com/george333999/local-first-agent-workbench",
  "bugs": {
    "url": "https://gitee.com/george333999/local-first-agent-workbench/issues"
  },
  "exports": {
    ".": "./index.js",
    "./cache": "./server/prefix.js",
    "./history": "./server/history-window.js",
    "./tools": "./server/tool-result.js",
    "./context": "./server/turn-context.js",
    "./prefetch": "./server/context-prefetch.js",
    "./scheduler": "./server/task-scheduler.js",
    "./locks": "./server/resource-locks.js",
    "./scope": "./server/command-scope.js",
    "./verify": "./server/verify-scheduler.js",
    "./metrics": "./server/benchmark-metrics.js",
    "./ptc": "./server/ptc/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "server",
    "docs",
    "examples",
    "benchmark/report.mjs",
    "benchmark/report-preview.html",
    "benchmark/README.md",
    "benchmark/data",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "example:minimal": "node examples/minimal-agent.mjs",
    "example:ptc": "node examples/ptc-batch.mjs",
    "example:context": "node examples/context-engine.mjs",
    "benchmark:report": "node benchmark/report.mjs"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "ptc",
    "prompt-cache",
    "long-context",
    "context-engine",
    "tool-calling",
    "token-optimization",
    "agent-scheduler",
    "resource-lock",
    "write-lock",
    "verification-scheduling",
    "local-first"
  ],
  "dependencies": {
    "acorn": "^8.19.0"
  }
}
