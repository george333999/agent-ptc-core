{
  "name": "cache-stable-agent-core",
  "version": "0.5.5",
  "description": "Cache-stable agent core: append-only long conversations, context budget derived from the model window, tool-result distillation, sandboxed programmatic tool calls, task contracts, deliverable guards, write locks and same-turn tool scheduling.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/george333999/local-first-agent-workbench.git"
  },
  "homepage": "https://gitee.com/george333999/local-first-agent-workbench",
  "bugs": {
    "url": "https://gitee.com/george333999/local-first-agent-workbench/issues"
  },
  "exports": {
    ".": "./index.js",
    "./cache": "./server/prefix.js",
    "./history": "./server/history-window.js",
    "./tools": "./server/tool-result.js",
    "./contract": "./server/task-contract.js",
    "./deliverable": "./server/deliverable.js",
    "./limits": "./server/limits.js",
    "./context": "./server/turn-context.js",
    "./guard": "./server/context-guard.js",
    "./prefetch": "./server/context-prefetch.js",
    "./parallel": "./server/parallel-tools.js",
    "./tool-scheduler": "./server/tool-scheduler.js",
    "./paths": "./server/paths.js",
    "./llm": "./server/llm-governor.js",
    "./latency": "./server/latency-metrics.js",
    "./scheduler": "./server/task-scheduler.js",
    "./economics": "./server/orchestration-economics.js",
    "./report": "./server/orchestration-report.js",
    "./locks": "./server/resource-locks.js",
    "./mutex": "./server/locks.js",
    "./scope": "./server/command-scope.js",
    "./verify": "./server/verify-scheduler.js",
    "./metrics": "./server/benchmark-metrics.js",
    "./ptc": "./server/ptc/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "server",
    "docs",
    "examples",
    "benchmark/report.mjs",
    "benchmark/report-preview.html",
    "benchmark/abba-report-2026-11-26.html",
    "benchmark/abba-report-2026-11-26.png",
    "benchmark/README.md",
